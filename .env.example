# ==============================================================================
# Multimodal Resume Intelligence & Screening Studio Configuration
# ==============================================================================

PROJECT_NAME="Multimodal Resume Intelligence & Screening Studio"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
BACKEND_URL="https://resume-screening-tvrt.onrender.com"
FRONTEND_URL="https://frontend-seven-taupe-72.vercel.app"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "https://frontend-seven-taupe-72.vercel.app", "https://resume-screening-tvrt.onrender.com"]

# MongoDB Atlas Database Configuration
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://sample_user:sample_password@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="multimodal_resume_intel"
ENABLE_LOCAL_FALLBACK_STORE=true
FALLBACK_DATA_DIR="./data/fallback_store"

# Multimodal & NLP Model Profiles
WHISPER_MODEL_SIZE="base"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
SENTIMENT_MODEL_NAME="distilbert/distilbert-base-uncased-finetuned-sst-2-english"
